# 依赖
node_modules/
**/node_modules/

# 环境变量（含 JWT 等，切勿提交）
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.local
frontend-mobile/.env
frontend-mobile/.env.local

# 本地加密密钥库（API Key 存于此，切勿提交）
backend/data/
**/secrets.vault
**/.vault-key

# 临时上传目录
backend/uploads/temp/

# 用户上传的视频/封面（体积大且为本地数据）
uploads/*
!uploads/videos/.gitkeep
!uploads/covers/.gitkeep

# 数据库
*.db
**/*.db

# 构建产物
frontend/dist/
frontend-mobile/dist/
dist/

# Capacitor Android 构建产物
frontend-mobile/android/.gradle/
frontend-mobile/android/app/build/
frontend-mobile/android/build/
frontend-mobile/android/local.properties
frontend-mobile/android/.idea/

# 日志与缓存
*.log
.vite/
**/.vite/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini
