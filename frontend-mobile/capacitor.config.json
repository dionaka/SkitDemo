{
  "appId": "com.skitdemo.app",
  "appName": "短剧互动",
  "webDir": "dist",
  "server": {
    "androidScheme": "http"
  },
  "android": {
    "adjustMarginsForEdgeToEdge": "disable"
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": false,
      "backgroundColor": "#07070d",
      "style": "DARK"
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": false,
      "backgroundColor": "#07070d",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
